@@ -0,0 +1,21 @@
+/*
+ * Copyright (c) 2021 Byte-Lab Grupa
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <mem.h>
+#include <st/h7/stm32h7b3.dtsi>
+
+/* STM32H7B0 differs from STM32H7B3 only in amount of flash */
+/ {
+	soc {
+		flash-controller@52002000 {
